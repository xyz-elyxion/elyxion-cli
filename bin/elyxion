#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Resolve symlinks so we find the binary relative to the real script location
if command -v realpath >/dev/null 2>&1; then
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$(realpath "$0")")" && pwd)
elif command -v readlink >/dev/null 2>&1 && readlink -f "$0" >/dev/null 2>&1; then
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$(readlink -f "$0")")" && pwd)
fi

find_binary() {
  # 1. ELYXION_HOME env var (set by install.sh wrappers)
  if [ -n "${ELYXION_HOME:-}" ] && [ -x "$ELYXION_HOME/elyxion" ]; then
    echo "$ELYXION_HOME/elyxion"
    return
  fi

  # 2. Standard install location
  if [ -x "$HOME/.elyxion/elyxion" ]; then
    echo "$HOME/.elyxion/elyxion"
    return
  fi

  # 3. Build directory (development)
  if [ -x "$SCRIPT_DIR/../build/elyxion" ]; then
    echo "$SCRIPT_DIR/../build/elyxion"
    return
  fi

  # 4. Flat layout next to script (release archive)
  if [ -x "$SCRIPT_DIR/../elyxion" ]; then
    echo "$SCRIPT_DIR/../elyxion"
    return
  fi

  # 5. Flat layout with .bin suffix (release archive)
  if [ -x "$SCRIPT_DIR/../elyxion.bin" ]; then
    echo "$SCRIPT_DIR/../elyxion.bin"
    return
  fi

  # 6. System install
  if [ -x "/usr/local/bin/elyxion" ] && [ "$(realpath "/usr/local/bin/elyxion" 2>/dev/null || echo '')" != "$0" ]; then
    echo "/usr/local/bin/elyxion"
    return
  fi

  return 1
}

if BINARY=$(find_binary); then
  exec "$BINARY" "$@"
fi

echo "elyxion: standalone binary not found" >&2
echo "  Build from source: cmake -B build && cmake --build build" >&2
echo "  Or install: curl -fsSL https://raw.githubusercontent.com/xyz-elyxion/elyxion-cli/main/scripts/install.sh | bash" >&2
exit 1
