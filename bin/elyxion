#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$SCRIPT_DIR/../build/elyxion" ]; then
  exec "$SCRIPT_DIR/../build/elyxion" "$@"
fi

if [ -x "$SCRIPT_DIR/../elyxion" ]; then
  exec "$SCRIPT_DIR/../elyxion" "$@"
fi

if [ -x "$SCRIPT_DIR/../elyxion.bin" ]; then
  exec "$SCRIPT_DIR/../elyxion.bin" "$@"
fi

echo "elyxion: standalone binary not found; build with CMake first" >&2
exit 1
